{
  "manifest_version": 3,
  "name": "GitHub Radar",
  "version": "1.0.0",
  "description": "本地运行的开源项目雷达：发现、分类、Star 增长追踪与 AI 商业分析。",
  "action": {
    "default_title": "GitHub Radar",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "alarms", "unlimitedStorage"],
  "host_permissions": ["https://api.github.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
